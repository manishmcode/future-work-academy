
Options -MultiViews
DirectoryIndex index.html
ErrorDocument 404 /404.html

RewriteEngine On

# ==========================================
# 1. CANONICAL URL REDIRECTS
# ==========================================

# Canonical format:
# https://futureworkacademy.net/path/
# - HTTPS only
# - non-www hostname
# - trailing slash for page routes

RewriteCond %{HTTPS} !=on [OR]
RewriteCond %{HTTP_HOST} ^www\.futureworkacademy\.net$ [NC]
RewriteRule ^ https://futureworkacademy.net%{REQUEST_URI} [R=301,L,NE]

RewriteRule ^(courses|pricing|unsubscribe|login|signup|privacy-policy|terms-conditions|imprint|checkout)$ /$1/ [R=301,L,NE]


# ==========================================
# 2. SECURITY HEADERS
# ==========================================

<IfModule mod_headers.c>
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
  Header always set Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; img-src 'self' data: https://images.unsplash.com https://i.pravatar.cc https://www.gstatic.com https://fonts.gstatic.com https://www.google.com https://translate.googleapis.com https://translate.google.com; font-src 'self' data: https://fonts.gstatic.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://translate.googleapis.com https://www.gstatic.com; script-src 'self' 'unsafe-inline' https://translate.google.com https://translate.googleapis.com https://www.gstatic.com https://translate-pa.googleapis.com https://static.cloudflareinsights.com; connect-src 'self' https://futureworkacademy.net https://translate.googleapis.com https://translate-pa.googleapis.com; frame-src 'self' https://translate.google.com https://translate.googleapis.com; worker-src 'self' blob:; manifest-src 'self'; media-src 'self'; upgrade-insecure-requests"
  Header always set X-Frame-Options "DENY"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "accelerometer=(), camera=(), geolocation=(), gyroscope=(), microphone=(), payment=(), usb=()"
  Header always set Cross-Origin-Opener-Policy "same-origin-allow-popups"
</IfModule>


# ==========================================
# 2b. BROWSER CACHING
# ==========================================

<IfModule mod_headers.c>
  # CRA build output in /static/ has content hashes in filenames, so it can be cached forever.
  <If "%{REQUEST_URI} =~ m#^/static/#">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </If>

  # Images, fonts and icons keep stable filenames; rename the file when replacing one.
  <ElseIf "%{REQUEST_URI} =~ m#\.(webp|png|jpe?g|gif|svg|ico|avif|woff2?|ttf|otf)$#i">
    Header set Cache-Control "public, max-age=31536000"
  </ElseIf>

  <ElseIf "%{REQUEST_URI} =~ m#\.(json|xml|txt|webmanifest)$#i">
    Header set Cache-Control "public, max-age=86400"
  </ElseIf>

  # index.html and SPA routes must revalidate so new deploys are picked up immediately.
  <ElseIf "%{REQUEST_URI} =~ m#(^/$|\.html$|/$)#">
    Header set Cache-Control "no-cache"
  </ElseIf>
</IfModule>


# ==========================================
# 3. PRIVATE ROUTE REDIRECTS
# ==========================================

# These are temporary auth/access redirects. Do not cache them as permanent SEO redirects.

RewriteCond %{HTTP:Cookie} !(^|;\s*)futureworkacademy_auth_hint=1(;|$) [NC]
RewriteRule ^(library|schedule|live-room)/?$ /pricing/ [R=302,L,NE]

RewriteCond %{HTTP:Cookie} !(^|;\s*)futureworkacademy_auth_hint=1(;|$) [NC]
RewriteRule ^(account|profile)/?$ /login/ [R=302,L,NE]

RewriteCond %{HTTP:Cookie} (^|;\s*)futureworkacademy_auth_hint=1(;|$) [NC]
RewriteRule ^profile/?$ /account/ [R=302,L,NE]

RewriteCond %{HTTP:Cookie} (^|;\s*)futureworkacademy_auth_hint=1(;|$) [NC]
RewriteRule ^(library|schedule|live-room|account)$ /$1/ [R=301,L,NE]


# ==========================================
# 4. BLOCK DIRECT LIBRARY ASSET ACCESS
# ==========================================

# Uploaded library assets must not be
# accessed directly through /assets/.

RewriteRule ^assets/[0-9]+/ - [R=404,L]


# ==========================================
# 5. SIGNED ASSET ROUTING
# ==========================================

# Rewrite /v/TOKEN internally to the
# existing Passenger Node.js application.
#
# Browser URL remains /v/TOKEN.
#
# This requires Passenger to accept
# internally rewritten requests.

RewriteRule ^v/(.+)$ /future-work-api/v/$1 [L,NC,NE]


# ==========================================
# 6. BACKEND API ROUTING
# ==========================================

# Keep existing Passenger application
# requests out of frontend routing.

RewriteRule ^future-work-api(?:/|$) - [L,NC]


# ==========================================
# 7. FRONTEND 404 ROUTE
# ==========================================

RewriteRule ^404$ /404/ [R=301,L,NE]
RewriteRule ^404/$ - [R=404,L]


# ==========================================
# 8. SERVE EXISTING STATIC FILES
# ==========================================

RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]


# ==========================================
# 9. FRONTEND ROUTES
# ==========================================

# React routes should load index.html when opened
# directly or after a hard refresh.

RewriteRule ^(courses|library|schedule|live-room|pricing|unsubscribe|login|signup|privacy-policy|terms-conditions|imprint|account|checkout|profile)/$ /index.html [L,NC]


# ==========================================
# 10. UNKNOWN ROUTES RETURN 404
# ==========================================

RewriteRule ^ - [R=404,L]
